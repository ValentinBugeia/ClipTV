# Twitch : https://dev.twitch.tv/console/apps (app "Confidential")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok : https://developers.tiktok.com/ (produits "Login Kit" + "Content Posting API")
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
