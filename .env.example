# Twitch : https://dev.twitch.tv/console/apps (app "Confidential")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok : https://developers.tiktok.com/ (produits "Login Kit" + "Content Posting API")
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://example.com/callback

# Whisper : tiny | base | small | medium | large-v3   (small = bon compromis CPU)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto

CLIPBOT_DATA_DIR=data

# Légendes générées par Claude (--ai-caption) : clé API ou `ant auth login`
ANTHROPIC_API_KEY=
CLIPBOT_LLM_MODEL=claude-opus-5-5
