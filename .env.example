# ───────── Accès à l'interface web ─────────
# Obligatoire sur un serveur : l'interface demande ce mot de passe (utilisateur : admin)
CLIPBOT_REVIEW_PASSWORD=
# Nom de domaine pointant vers le serveur, pour le HTTPS automatique (profil docker « https »)
CLIPBOT_DOMAIN=
# Avec HTTPS, n'expose l'app que via Caddy :
# CLIPBOT_BIND=127.0.0.1

# ───────── Valeurs de départ du pilote automatique ─────────
# (modifiables ensuite dans l'interface, page « Pilote auto »)
# langue des streams scannés par la découverte automatique (vide = toutes)
CLIPBOT_LANGUAGE=fr
# chaînes favorites, toujours incluses (facultatif)
CLIPBOT_CHANNELS=
CLIPBOT_WATCH_CHANNELS=
# plateformes : tiktok,youtube,instagram
CLIPBOT_PLATFORMS=tiktok
CLIPBOT_POST_SLOTS=12:30,18:00,21:00
CLIPBOT_TIMEZONE=Europe/Paris

# ───────── Twitch : https://dev.twitch.tv/console/apps (app « Confidential ») ─────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ───────── TikTok : https://developers.tiktok.com/ (Login Kit + Content Posting API) ─────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# doit être https://<ton-domaine>/tiktok/callback pour connecter TikTok depuis l'interface
TIKTOK_REDIRECT_URI=https://example.com/tiktok/callback

# ───────── YouTube : console Google Cloud, client OAuth « TV et appareils à entrée limitée » ─────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# private | unlisted | public
YOUTUBE_PRIVACY=private

# ───────── Instagram : compte pro + app Meta (le token se colle dans l'interface) ─────────
# INSTAGRAM_USER_ID=
# INSTAGRAM_GRAPH_HOST=graph.instagram.com

# ───────── Claude (légendes) ─────────
ANTHROPIC_API_KEY=
CLIPBOT_LLM_MODEL=claude-opus-5-5

# ───────── Divers ─────────
# Whisper : tiny | base | small | medium | large-v3   (small = bon compromis CPU)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
CLIPBOT_DATA_DIR=data
